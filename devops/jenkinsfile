pipeline {
    agent any

    environment {
        LOCAL_REGISTRY = 'local-registry:5000'
    }

    stages {
        stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
            }
        }

        stage('Lint') {
            agent {
                dockerfile {
                    dir 'devops'
                    filename 'ci.Dockerfile'
                }
            }
            steps {
                sh 'HOME=$WORKSPACE python -m pip install --user -r requirements.txt flake8 mypy'
                sh 'HOME=$WORKSPACE PATH=$WORKSPACE/.local/bin:$PATH make lint'
            }
        }

        stage('Test') {
            agent {
                dockerfile {
                    dir 'devops'
                    filename 'ci.Dockerfile'
                }
            }
            steps {
                sh 'HOME=$WORKSPACE python -m pip install --user -r requirements.txt'
                sh 'HOME=$WORKSPACE PATH=$WORKSPACE/.local/bin:$PATH pytest -q'
            }
        }

        stage('Check registry credentials') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'local-registry-creds',
                    usernameVariable: 'REGISTRY_USER',
                    passwordVariable: 'REGISTRY_PASS'
                )]) {
                    sh '''
                        test -n "$REGISTRY_USER"
                        test -n "$REGISTRY_PASS"
                    '''
                    echo "Local registry credentials are configured for ${env.LOCAL_REGISTRY}"
                }
            }
        }
    }
}
